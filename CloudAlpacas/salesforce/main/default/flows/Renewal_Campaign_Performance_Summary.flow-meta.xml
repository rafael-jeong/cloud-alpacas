<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Accumulate</name>
        <label>누적 합산</label>
        <locationX>150</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>varTotalContacts</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Collab_Campaigns.NumberOfContacts</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTotalResponses</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Collab_Campaigns.NumberOfResponses</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTotalDeliverableWeight</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Collab_Campaigns.Total_Deliverable_Weight__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCompletedDeliverableWeight</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Collab_Campaigns.Completed_Deliverable_Weight__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Completed_Check</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_First_Amount</name>
        <label>최초 계약 금액 설정</label>
        <locationX>100</locationX>
        <locationY>1050</locationY>
        <assignmentItems>
            <assignToReference>varFirstAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varSiblingOpp.Amount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Collab_Campaigns</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Increment_Count</name>
        <label>완료 카운트 증가</label>
        <locationX>100</locationX>
        <locationY>550</locationY>
        <assignmentItems>
            <assignToReference>varCollabCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Sibling_Opp</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Latest_Info</name>
        <label>최신 정보 갱신</label>
        <locationX>150</locationX>
        <locationY>850</locationY>
        <assignmentItems>
            <assignToReference>varLatestTier</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varSiblingOpp.Partner_Tier__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varLatestAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varSiblingOpp.Amount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_First_Amount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Summary_Diamond</name>
        <label>Diamond 요약 반영</label>
        <locationX>200</locationX>
        <locationY>1250</locationY>
        <assignmentItems>
            <assignToReference>$Record.Performance_Summary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxSummaryDiamond</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Summary_Gold</name>
        <label>Gold 요약 반영</label>
        <locationX>350</locationX>
        <locationY>1250</locationY>
        <assignmentItems>
            <assignToReference>$Record.Performance_Summary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxSummaryGold</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Summary_Platinum</name>
        <label>Platinum 요약 반영</label>
        <locationX>50</locationX>
        <locationY>1250</locationY>
        <assignmentItems>
            <assignToReference>$Record.Performance_Summary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxSummaryPlatinum</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_Completed_Check</name>
        <label>완료된 시즌인가</label>
        <locationX>150</locationX>
        <locationY>450</locationY>
        <defaultConnector>
            <targetReference>Get_Sibling_Opp</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Completed</defaultConnectorLabel>
        <rules>
            <name>Is_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Collab_Campaigns.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Increment_Count</targetReference>
            </connector>
            <label>Completed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_First_Amount</name>
        <label>최초 계약 금액 미설정 시</label>
        <locationX>150</locationX>
        <locationY>950</locationY>
        <defaultConnector>
            <targetReference>Loop_Collab_Campaigns</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>이미 설정됨</defaultConnectorLabel>
        <rules>
            <name>Not_Set_Yet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFirstAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_First_Amount</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Opp_Exists</name>
        <label>Opportunity 존재 여부</label>
        <locationX>150</locationX>
        <locationY>750</locationY>
        <defaultConnector>
            <targetReference>Loop_Collab_Campaigns</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>없음</defaultConnectorLabel>
        <rules>
            <name>Opp_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSiblingOpp.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Latest_Info</targetReference>
            </connector>
            <label>있음</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Tier_Branch</name>
        <label>티어별 분기</label>
        <locationX>50</locationX>
        <locationY>1150</locationY>
        <defaultConnector>
            <targetReference>Assign_Summary_Gold</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Gold(기본)</defaultConnectorLabel>
        <rules>
            <name>Is_Diamond</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLatestTier</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Diamond</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Summary_Diamond</targetReference>
            </connector>
            <label>Diamond</label>
        </rules>
        <rules>
            <name>Is_Platinum</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLatestTier</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Platinum</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Summary_Platinum</targetReference>
            </connector>
            <label>Platinum</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fxDeliverableRate</name>
        <dataType>Number</dataType>
        <expression>IF({!varTotalDeliverableWeight} = 0, 0, {!varCompletedDeliverableWeight} / {!varTotalDeliverableWeight} * 100)</expression>
        <scale>1</scale>
    </formulas>
    <formulas>
        <name>fxGrowthRate</name>
        <dataType>Number</dataType>
        <expression>IF({!varFirstAmount} = 0, 0, ({!varLatestAmount} - {!varFirstAmount}) / {!varFirstAmount} * 100)</expression>
        <scale>1</scale>
    </formulas>
    <formulas>
        <name>fxResponseRate</name>
        <dataType>Number</dataType>
        <expression>IF({!varTotalContacts} = 0, 0, {!varTotalResponses} / {!varTotalContacts} * 100)</expression>
        <scale>1</scale>
    </formulas>
    <formulas>
        <name>fxSummaryDiamond</name>
        <dataType>String</dataType>
        <expression>&quot;[스폰서십 성과 요약 - Diamond 파트너 갱신 참고자료]&quot; &amp; BR() &amp; BR() &amp; &quot;■ 독점 지위 기반 성과&quot; &amp; BR() &amp; &quot;귀사는 업종 내 유일한 공식 파트너 지위를 보유하고 있어, 아래 팬 도달·반응이 경쟁 브랜드와 공유되지 않고 전부 귀사 브랜드로 귀속되었습니다.&quot; &amp; BR() &amp; &quot;독점 도달 팬 수: &quot; &amp; TEXT({!varTotalContacts}) &amp; &quot;명&quot; &amp; BR() &amp; &quot;독점 반응 팬 수: &quot; &amp; TEXT({!varTotalResponses}) &amp; &quot;명&quot; &amp; BR() &amp; BR() &amp; &quot;■ 파트너십 성장&quot; &amp; BR() &amp; &quot;1년차 계약 규모 대비 최근 계약 규모 &quot; &amp; TEXT({!fxGrowthRate}) &amp; &quot;% 성장&quot; &amp; BR() &amp; &quot;(완료된 협업 시즌: &quot; &amp; TEXT({!varCollabCount}) &amp; &quot;회)&quot; &amp; BR() &amp; BR() &amp; &quot;■ 약속 이행 신뢰도&quot; &amp; BR() &amp; &quot;약속한 실행 항목 중 &quot; &amp; TEXT({!fxDeliverableRate}) &amp; &quot;% 완료&quot; &amp; BR() &amp; BR() &amp; &quot;이 성과를 바탕으로 파트너십 갱신을 제안드립니다.&quot;</expression>
    </formulas>
    <formulas>
        <name>fxSummaryGold</name>
        <dataType>String</dataType>
        <expression>&quot;[스폰서십 성과 요약 - Gold 파트너 갱신 참고자료]&quot; &amp; BR() &amp; BR() &amp; &quot;■ 브랜드 노출 성과&quot; &amp; BR() &amp; &quot;총 노출된 팬(Contact) 수: &quot; &amp; TEXT({!varTotalContacts}) &amp; &quot;명&quot; &amp; BR() &amp; BR() &amp; &quot;■ 약속 이행 신뢰도&quot; &amp; BR() &amp; &quot;약속한 실행 항목 중 &quot; &amp; TEXT({!fxDeliverableRate}) &amp; &quot;% 완료&quot; &amp; BR() &amp; BR() &amp; &quot;이 성과를 바탕으로 갱신 또는 Platinum 승급을 제안드립니다.&quot;</expression>
    </formulas>
    <formulas>
        <name>fxSummaryPlatinum</name>
        <dataType>String</dataType>
        <expression>&quot;[스폰서십 성과 요약 - Platinum 파트너 갱신 참고자료]&quot; &amp; BR() &amp; BR() &amp; &quot;■ 팬 도달 및 반응&quot; &amp; BR() &amp; &quot;총 노출된 팬(Contact) 수: &quot; &amp; TEXT({!varTotalContacts}) &amp; &quot;명&quot; &amp; BR() &amp; &quot;실제 반응(참여)한 팬 수: &quot; &amp; TEXT({!varTotalResponses}) &amp; &quot;명&quot; &amp; BR() &amp; &quot;팬 반응율: &quot; &amp; TEXT({!fxResponseRate}) &amp; &quot;%&quot; &amp; BR() &amp; BR() &amp; &quot;■ 약속 이행 신뢰도&quot; &amp; BR() &amp; &quot;약속한 실행 항목 중 &quot; &amp; TEXT({!fxDeliverableRate}) &amp; &quot;% 완료&quot; &amp; BR() &amp; BR() &amp; &quot;이 성과를 바탕으로 갱신 또는 Diamond 승급을 제안드립니다.&quot;</expression>
    </formulas>
    <interviewLabel>갱신 캠페인 성과 요약 자동 생성 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>갱신 캠페인 성과 요약 자동 생성</label>
    <loops>
        <name>Loop_Collab_Campaigns</name>
        <label>형제 캠페인 순회</label>
        <locationX>50</locationX>
        <locationY>250</locationY>
        <collectionReference>colCollabCampaigns</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Accumulate</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Decision_Tier_Branch</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Collab_Campaigns</name>
        <label>형제 협업 캠페인 조회</label>
        <locationX>50</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Collab_Campaigns</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND 3</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012bm00000BbzKjAAJ</stringValue>
            </value>
        </filters>
        <object>Campaign</object>
        <outputReference>colCollabCampaigns</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>NumberOfContacts</queriedFields>
        <queriedFields>NumberOfResponses</queriedFields>
        <queriedFields>Total_Deliverable_Weight__c</queriedFields>
        <queriedFields>Completed_Deliverable_Weight__c</queriedFields>
        <queriedFields>Status</queriedFields>
        <sortField>StartDate</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Get_Sibling_Opp</name>
        <label>해당 캠페인의 Opportunity 조회</label>
        <locationX>150</locationX>
        <locationY>650</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Opp_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Collab_Campaigns.Id</elementReference>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputReference>varSiblingOpp</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Partner_Tier__c</queriedFields>
        <queriedFields>Amount</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Collab_Campaigns</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012bm00000BiNKRAA3</stringValue>
            </value>
        </filters>
        <filters>
            <field>ParentId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Campaign</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
