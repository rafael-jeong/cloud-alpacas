<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <description>기존 Attendance Record 조회 결과를 확인하여 신규 생성 여부를 결정</description>
        <name>Does_Attendance_Record_Need_Creation</name>
        <label>Does Attendance Record Need Creation?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Attendance Record Already Exists</defaultConnectorLabel>
        <rules>
            <name>No_Existing_Attendance_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Attendance_Record.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Attendance_Record</targetReference>
            </connector>
            <label>No Existing Attendance Record</label>
        </rules>
    </decisions>
    <decisions>
        <description>활성화된 Welcome Campaign 레코드가 조회되었는지 확인</description>
        <name>Was_Welcome_Campaign_Found</name>
        <label>Was Welcome Campaign Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Existing_Attendance_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Campaign Not Found</defaultConnectorLabel>
        <rules>
            <name>Campaign_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Welcome_Campaign.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Welcome_Campaign_Member</targetReference>
            </connector>
            <label>Campaign Found</label>
        </rules>
    </decisions>
    <description>Person Account 신규 생성 시 New Fan 세그먼트 이력, Welcome Campaign Member, Notification Log 및 Attendance Record를 생성</description>
    <environments>Default</environments>
    <interviewLabel>Welcome Campaign Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Welcome Campaign Flow -CA</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>기존 관람 이력 집계가 없는 신규 팬에게 Attendance Record를 생성</description>
        <name>Create_Attendance_Record</name>
        <label>Create Attendance Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Fan__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Attendance_Record__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>신규 Person Account의 신 Fan Segment 이력을 생성</description>
        <name>Create_New_Fan_Segment_History</name>
        <label>Create New Fan Segment History</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Current_Segment_to_New_Fan</targetReference>
        </connector>
        <inputAssignments>
            <field>Changed_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Fan__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reason__c</field>
            <value>
                <stringValue>최초 가입</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Segment__c</field>
            <value>
                <stringValue>New Fan</stringValue>
            </value>
        </inputAssignments>
        <object>Fan_Segment_History__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>신규 Person Account를 Welcome Campaign의 캠페인 멤버로 등록</description>
        <name>Create_Welcome_Campaign_Member</name>
        <label>Create Welcome Campaign Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Welcome_Notification_Log</targetReference>
        </connector>
        <inputAssignments>
            <field>CampaignId</field>
            <value>
                <elementReference>Get_Welcome_Campaign.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.PersonContactId</elementReference>
            </value>
        </inputAssignments>
        <object>CampaignMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>신규 팬의 Welcome Campaign 안내 이력을 Notification Log에 기록</description>
        <name>Create_Welcome_Notification_Log</name>
        <label>Create Welcome Notification Log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Attendance_Record</targetReference>
        </connector>
        <inputAssignments>
            <field>Campaign__c</field>
            <value>
                <elementReference>Get_Welcome_Campaign.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Content__c</field>
            <value>
                <stringValue>Welcome Campaign 신규 가입 안내</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Fan__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sent_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Notification_Log__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>신규 팬에게 기존 Attendance Record가 있는지 조회하여 중복 생성을 방지</description>
        <name>Get_Existing_Attendance_Record</name>
        <label>Get Existing Attendance Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_Attendance_Record_Need_Creation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Fan__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Attendance_Record__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>신규 가입 팬을 Welcome Campaign에 연결하기 위해 활성화된 Welcome Campaign 레코드를 조회</description>
        <name>Get_Welcome_Campaign</name>
        <label>Get Welcome Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_Welcome_Campaign_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Welcome Campaign</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Campaign</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>신규 Person Account의 현재 세그먼트를 New Fan으로 업데이트</description>
        <name>Set_Current_Segment_to_New_Fan</name>
        <label>Set Current Segment to New Fan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Welcome_Campaign</targetReference>
        </connector>
        <inputAssignments>
            <field>Current_Segment__c</field>
            <value>
                <stringValue>New Fan</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_New_Fan_Segment_History</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsPersonAccount</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
